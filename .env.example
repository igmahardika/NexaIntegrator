APP_NAME="WiFiPads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Portal public URL (used in captive portal redirects)
PORTAL_URL=http://portal.wifipads.local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=captive_portal
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@wifipads.com"
MAIL_FROM_NAME="${APP_NAME}"

# MikroTik RouterOS API Default Settings
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_TIMEOUT=5
MIKROTIK_ATTEMPTS=3
